# AI Usage Observatory settings
#
# Copy this file to .env.local and uncomment only what you need:
#
#   cp .env.example .env.local
#
# Bun and Vite load .env.local automatically, and Git ignores it. Every setting
# is optional; the defaults suit a single Mac with everything on localhost.
#
# Leave a setting commented out to use its default. An empty value is not the
# same as unset: PORT= gives a random port, and an empty QUOTA_* value breaks
# that connection.

# --- Remote access (Tailscale Serve) ----------------------------------------

# Exact hostnames, comma-separated, that may reach the app besides localhost.
# No scheme, port, path, or wildcard. Do not use Tailscale Funnel.
# USAGE_OBSERVATORY_ALLOWED_HOSTS=your-mac.your-tailnet.ts.net

# Set to 1 to allow "Update and restart" from an allowed remote browser.
# Without it, remote browsers can check for updates but not apply them.
# This is a browser origin rule, not authentication.
# USAGE_OBSERVATORY_REMOTE_UPDATES=1

# --- Quota service ----------------------------------------------------------

# quota-service address. The Observatory connects to the default on its own.
# QUOTA_SERVICE_URL=http://127.0.0.1:8787

# Set to 0 to skip live quota requests. Stored quota history still loads.
# QUOTA_SERVICE_ENABLED=0

# quota-service history database. Defaults to ~/.quota-service/quota.db, which
# is read only when QUOTA_SERVICE_URL points at this machine. Set it when the
# service runs elsewhere but its database is reachable from here.
# QUOTA_DB_PATH=/path/to/quota.db

# --- Local data -------------------------------------------------------------

# Observatory database. A relative path resolves against the repository.
# USAGE_OBSERVATORY_DB=.usage-observatory/data.db

# Warp database, for a non-default Warp install (for example, Warp Preview).
# WARP_DB_PATH=/path/to/warp.sqlite

# Set to 1 to stop background downloads of the LiteLLM price list and the
# ccusage release check. The app uses cached or bundled data instead.
# USAGE_OBSERVATORY_OFFLINE_PRICING=1

# --- Server port ------------------------------------------------------------

# Port for `bun run start` and `bun run start:server`. Change it only if 4318
# is taken: `bun run dev` always proxies to 4318, and any `tailscale serve`
# target must match.
# PORT=4318
